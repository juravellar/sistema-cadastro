# Server
PORT=3002
NODE_ENV=production
# Obrigatório em produção. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Database
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sistema_cadastro

# Usado apenas por `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Webhook de deploy (webhook-server.js). Obrigatório para o servidor iniciar.
WEBHOOK_SECRET=
WEBHOOK_PORT=3003

# Dev: alvo do proxy /api do Vite
VITE_API_TARGET=http://localhost:3002

FRONTEND_URL=https://app.seudominio.com

# Defina "false" apenas se o acesso ao app não passar por HTTPS
# COOKIE_SECURE=false
