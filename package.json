{
  "name": "sistema-cadastro-fullstack",
  "version": "1.0.0",
  "description": "Sistema completo de cadastro com frontend React e backend Express.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "start": "cd backend && npm start",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "deploy:aapanel": "bash scripts/deploy-aapanel.sh",
    "pm2:start": "cd backend && pm2 start ecosystem.config.js --env production",
    "pm2:stop": "cd backend && pm2 stop sistema-cadastro-backend",
    "pm2:restart": "cd backend && pm2 restart sistema-cadastro-backend",
    "pm2:logs": "cd backend && pm2 logs sistema-cadastro-backend",
    "pm2:status": "cd backend && pm2 status",
    "webhook:start": "pm2 start webhook-ecosystem.config.js",
    "webhook:stop": "pm2 stop webhook-server",
    "webhook:restart": "pm2 restart webhook-server",
    "webhook:logs": "pm2 logs webhook-server",
    "clean": "rimraf backend/node_modules frontend/node_modules backend/dist frontend/dist",
    "test": "npm run test:webhook && npm test --prefix backend",
    "test:webhook": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm run lint --prefix frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "express",
    "nodejs",
    "postgresql",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  }
}
